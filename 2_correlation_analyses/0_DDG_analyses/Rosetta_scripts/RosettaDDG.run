#!/bin/bash -l
#SBATCH --qos=normal
#SBATCH --partition=standard                                             
#SBATCH --mem=30G
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=10             
#SBATCH --nodes=1   

### Submitted using following command:
### sbatch --array=1-X%4 ./RosettaDDG.run "./Brazzein/4HE7_relaxed.pdb" "./Brazzein/Brazzein_resfile_list.txt" "./Brazzein/Brazzein_DDG/"
### sbatch --array=1-5%4 ./Rosetta_scripts/RosettaDDG.run "./Thaumatin_i_2vhr/PDBs/2VHR_A_0015.pdb" "./Resfiles/thaumatin_i_resfiles.txt" "./Thaumatin_i_2vhr/DDG_predictions/"

# Path to Rosetta bin folder
ROSETTABIN=/projects/ilfgrid/apps/rosetta-3.13/rosetta_bin_linux_2021.16.61629_bundle/main/source/bin
ROSETTADB=/projects/ilfgrid/apps/rosetta-3.13/rosetta_bin_linux_2021.16.61629_bundle/main/database

PDB=$1
MUTATIONS=$2
OUTPUT=$3

PDB=`realpath $PDB`
MUTATIONS=`realpath $MUTATIONS`
OUTPUT=`realpath $OUTPUT`

# Read in mutation files from the list
MUTFILE=$(sed -n "${SLURM_ARRAY_TASK_ID}p" "${MUTATIONS}")

# Get the name of the mutation file
MUTNAME=`basename $MUTFILE _resfile.txt`

OUTPUT="${OUTPUT}/${MUTNAME}/"
mkdir -p $OUTPUT
cd $OUTPUT

# Run Rosetta Cartesian DDG protocol
$ROSETTABIN/cartesian_ddg.static.linuxgccrelease \
-database $ROSETTADB \
-s $PDB \
-run:constant_seed true \
-run:jran 1111111 \
-ddg:mut_file $MUTFILE \
-ddg:iterations 5 \
-force_iterations false \
-optimize_proline true \
-ddg::score_cutoff 1.0 \
-ddg::cartesian \
-ddg::dump_pdbs true \
-fa_max_dis 9.0 \
-score:weights ref2015_cart
