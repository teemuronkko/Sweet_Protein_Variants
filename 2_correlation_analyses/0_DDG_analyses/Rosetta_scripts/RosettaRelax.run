#!/bin/bash -l
#SBATCH --qos=normal
#SBATCH --job-name=RosettaRelax
#SBATCH --partition=standard                                             
#SBATCH --mem=40G
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16             
#SBATCH --nodes=1   

# Path to Rosetta bin folder
ROSETTABIN=/projects/ilfgrid/apps/rosetta-3.13/rosetta_bin_linux_2021.16.61629_bundle/main/source/bin

# Input PDB file
pdb=$1
output=$2
protocol=$3
mkdir -p $output

# NOTE: Use the following python script to clean up the input PDB file prior to running Relax
#ROSETTAMAIN=/projects/ilfgrid/apps/rosetta-3.13/rosetta_bin_linux_2021.16.61629_bundle/main
#python $ROSETTAMAIN/tools/protein_tools/scripts/clean_pdb.py

$ROSETTABIN/rosetta_scripts.static.linuxgccrelease -in:file:s $pdb \
-in:file:fullatom \
-run:constant_seed true \
-run:jran 1111112 \
-default_max_cycles 200 \
-missing_density_to_jump \
-ignore_zero_occupancy false \
-fa_max_dis 9 \
-nstruct 20 \
-out:path:pdb "${output}" \
-out:path:score "${output}" \
-parser:protocol $protocol